[{"id":"champ-k46","cat":"champ","name":"4:6 沖法","by":"2016 粕谷哲 Tetsu Kasuya","desc":"前 40% 水量分兩注決定酸甜，後 60% 分三注決定濃度；每注等前一注滴完再倒。","gear":"Hario V60（陶瓷）","drip":"v60","sw":false,"dose":20,"water":300,"temp":92,"temps":null,"um":900,"c40":33,"pours":[{"t":0,"add":50,"to":50},{"t":45,"add":70,"to":120},{"t":90,"add":60,"to":180},{"t":135,"add":60,"to":240},{"t":180,"add":60,"to":300}],"done":"約 3:30","beans":"可調性最高的通用沖法。前 40% 可以把酸往上或往下推，最能發揮的是酸甜明顯的淺中焙（衣索比亞、藝伎）。深焙也能用：粕谷哲本人示範淺焙用 93°C、深焙降到 83°C。","bean":"藝伎","src":"https://kurasu.kyoto/blogs/kurasu-journal/2016-world-brewers-cup-champion-tetsu-kasuya","est":"研磨（原文：粗研磨）、每注秒數","ey":16.3,"tds":1.26},{"id":"champ-chad2017","cat":"champ","name":"細研磨＋中心一大注","by":"2017 王策 Chad Wang","desc":"王策把豆子磨得很細（約 400 μm）、再篩掉細粉和粗粒，悶蒸後從中心一口氣注到 250 g，2 分鐘左右就滴完。研磨細讓萃取變快，時間短讓總萃取量剛好停在甜的位置。","gear":"Hario V60（陶瓷）","drip":"v60","sw":false,"dose":15,"water":250,"temp":93,"temps":null,"um":400,"c40":14.5,"pours":[{"t":0,"add":30,"to":30},{"t":30,"add":220,"to":250}],"done":"2:00–2:15","beans":"淺焙、高密度的水洗豆（藝伎、衣索比亞水洗）。細研磨讓難萃的硬豆萃得到位，時間短保持明亮。日曬或深焙磨這麼細容易苦。","bean":"藝伎","src":"https://www.baristamagazine.com/world-brewers-2017-recipe/","est":"悶蒸注水秒數","ey":21,"tds":1.43},{"id":"champ-emi2018","cat":"champ","name":"閥門浸泡＋冷熱交替","by":"2018 Emi Fukahori 深堀絵美","desc":"深堀絵美用可開關閥門的濾杯，把一杯拆成三段：關閥用 80°C 浸泡帶出甜感，開閥用 95°C 推萃取，再關閥用 80°C 收尾。一杯裡同時用了浸泡和滴濾、低溫和高溫。","gear":"GINA（可開關閥門）","drip":"cone","sw":true,"dose":17,"water":220,"temp":80,"temps":[80,95,80],"um":650,"c40":24,"pours":[{"t":0,"add":50,"to":50,"temp":80,"closed":1},{"t":45,"add":100,"to":150,"temp":95},{"t":105,"add":70,"to":220,"temp":80,"closed":1}],"done":"2:55","beans":"想要甜感和厚度的中淺焙到中焙。80°C 浸泡對日曬、發酵味重的豆也友善，不會把酒酵味一口氣推出來。","bean":"喜拉朵","src":"https://europeancoffeetrip.com/emi-fukahori-world-brewers-cup-champion/","est":"研磨、每注秒數","ey":20.8,"tds":1.91},{"id":"champ-sherry2022","cat":"champ","name":"低溫悶蒸、高溫萃取","by":"2022 Sherry Hsu","desc":"Sherry 第一注用 70°C 悶蒸，之後三注都用 95°C，每 30 秒注 50 g。低溫悶蒸先把香氣和酸留住、讓粉排氣，接著用高溫把甜和厚度一口氣拉出來。","gear":"OREA V3＋Kalita 185 濾紙","drip":"orea","sw":false,"dose":14,"water":200,"temp":95,"temps":[70,95,95,95],"um":650,"c40":24,"pours":[{"t":0,"add":50,"to":50,"temp":70},{"t":30,"add":50,"to":100,"temp":95},{"t":60,"add":50,"to":150,"temp":95},{"t":90,"add":50,"to":200,"temp":95}],"done":"","beans":"香氣細緻的淺焙：藝伎、花香型的衣索比亞。低溫悶蒸讓揮發性的花香留在杯子裡，之後再用高溫補萃取。","bean":"藝伎","src":"https://akarinohon.com/text/taketori.cgi/en.m.wikipedia.org/wiki/World_Brewers_Cup","est":"研磨、每注秒數","ey":16.7,"tds":1.36},{"id":"champ-wolfl2024","cat":"champ","name":"低擾動＋大注收尾","by":"2024 Martin Wölfl","desc":"Wölfl 先用佈粉針把粉打散、讓粉床密度均勻，注水時搭配 Melodrip 把水柱變成雨滴，最後一注一次倒 100 g。前段溫柔、後段乾脆，杯子乾淨又有厚度。","gear":"OREA V4 快速底＋Sibarist 濾紙","drip":"orea","sw":false,"dose":17,"water":270,"temp":93,"temps":null,"um":630,"c40":23,"pours":[{"t":0,"add":60,"to":60},{"t":40,"add":60,"to":120},{"t":80,"add":50,"to":170},{"t":120,"add":100,"to":270}],"done":"","beans":"淺焙、要求乾淨度的高價豆；也適合細粉多、容易塞水的豆子或磨豆機。低擾動讓細粉不會沖到底部。","bean":"藝伎","src":"https://akarinohon.com/text/taketori.cgi/en.m.wikipedia.org/wiki/World_Brewers_Cup","est":"每注秒數","ey":21.2,"tds":1.53},{"id":"champ-peng2025","cat":"champ","name":"高溫萃取、低溫收尾","by":"2025 George Jinyang Peng","desc":"Peng 前兩注用 96°C，最後一注換成 80°C、還透過 Melodrip 降低擾動，整杯不到兩分半就滴完。高溫先把甜和厚度拉出來，最後低溫收尾，讓杯子乾淨不苦。","gear":"Solo Dripper＋Melodrip","drip":"solo","sw":false,"dose":15,"water":210,"temp":96,"temps":[96,96,80],"um":550,"c40":20,"pours":[{"t":0,"add":30,"to":30,"temp":96},{"t":30,"add":90,"to":120,"temp":96},{"t":70,"add":90,"to":210,"temp":80}],"done":"約 2:15","beans":"淺焙但尾段容易苦澀的豆：日曬、厭氧、競標藝伎。Peng 比賽用的就是巴拿馬 Mount Totumas 的日曬藝伎。前段高溫拿甜，後段低溫踩煞車。","bean":"藝伎","src":"https://honestcoffeeguide.com/brew-recipes/george-jinyang-peng-2025-wbc/","est":"研磨（原文：中細研磨）、第三注開始時間與秒數","ey":18.5,"tds":1.54},{"id":"champ-kasuya10","cat":"champ","name":"超粗研磨＋10 段小注","by":"2026 粕谷哲 Tetsu Kasuya","desc":"粕谷哲在 2026 年提出的新沖法：研磨超粗（C40 約 40–45 格），96°C，30 g 悶蒸後每 15 秒注 30 g，共 10 注。每一注都很小，粉層幾乎不被翻動，杯子層次清楚、甜而不苦。","gear":"Hario V60 / V60 NEO","drip":"v60","sw":false,"dose":20,"water":300,"temp":96,"temps":null,"um":1200,"c40":44,"pours":[{"t":0,"add":30,"to":30},{"t":30,"add":30,"to":60},{"t":45,"add":30,"to":90},{"t":60,"add":30,"to":120},{"t":75,"add":30,"to":150},{"t":90,"add":30,"to":180},{"t":105,"add":30,"to":210},{"t":120,"add":30,"to":240},{"t":135,"add":30,"to":270},{"t":150,"add":30,"to":300}],"done":"3:00–3:30","beans":"高品質、香氣層次多的淺焙豆。超粗研磨加 96°C 萃得慢而穩，層次清楚；深焙用高溫長時間會苦，不建議。","bean":"藝伎","src":"https://roastaroma.com/blog/tetsu-kasuyas-new-multi-pour-method-2026-the-10-pour-super-coarse-v60-recipe","est":"研磨（原文：C40 約 40–45 格）、每注秒數","ey":14.9,"tds":1.15},{"id":"champ-nagasaki","cat":"champ","name":"七段注水、水溫一路降","by":"2026 長崎愛美 Megumi Nagasaki","desc":"長崎愛美用 17.5 g 粉、粗研磨、粉水比 1:12，每 20 秒注 30 g，共 7 注。水溫從 90°C 一路降到 75°C。前段高溫帶出香氣和酸，後段越來越冷，濃而不苦。","gear":"Hario V60（樹脂）","drip":"v60","sw":false,"dose":17.5,"water":210,"temp":90,"temps":[90,88,85,83,80,78,75],"um":700,"c40":25.5,"pours":[{"t":0,"add":30,"to":30,"temp":90},{"t":20,"add":30,"to":60,"temp":88},{"t":40,"add":30,"to":90,"temp":85},{"t":60,"add":30,"to":120,"temp":83},{"t":80,"add":30,"to":150,"temp":80},{"t":100,"add":30,"to":180,"temp":78},{"t":120,"add":30,"to":210,"temp":75}],"done":"2:20 注完","beans":"想喝濃（1:12）又不要苦：甜感好的中淺焙。原始配方用 La Esmeralda 水洗藝伎；水溫一路降，把苦澀壓住。","bean":"塔拉珠","src":"https://www.threads.com/@sipwithshin","est":"研磨（原文：粗研磨，模擬用 700 μm）、每注秒數、中間幾注的水溫（原文只寫 90°C → 75°C）","ey":15.8,"tds":1.59},{"id":"champ-bavis","cat":"champ","name":"雙層三明治萃取法","by":"2026 Bavis Kwong","desc":"Bavis 不追求粒徑完全一致，而是把差異拿來用：用 900 μm 篩網把粉分成粗細兩份，約 2 g 細粉放在底層，中間隔一張濾紙，上面放約 14 g 粗粉。乾悶蒸只用 15 g、94°C 的水，只濕上層粗粉，讓底層細粉晚一點才開始萃。","gear":"Contour（模擬用 V60）＋兩張濾紙","drip":"v60","sw":false,"dose":16,"water":240,"temp":94,"temps":null,"um":1000,"c40":36.5,"pours":[{"t":0,"add":15,"to":15},{"t":30,"add":75,"to":90},{"t":65,"add":75,"to":165},{"t":100,"add":75,"to":240}],"done":"","beans":"複雜度高的特殊處理藝伎（原始用豆是巴拿馬 Jansen 低溫發酵藝伎）。細粉被當成甜感和厚度的來源，一般商業豆效益不大。","bean":"","src":"https://vocus.cc/article/6a5593edfd8978000188fe16","est":"總水量與注水時間","ey":14.7,"tds":1.11},{"id":"orea-bright","cat":"orea","name":"The Bright","by":"","desc":"早上想偷懶的簡單配方：75／75／150 三段，杯子明亮開心。","gear":"OREA＋蛋糕濾紙","drip":"orea","sw":false,"dose":18,"water":300,"ice":0,"bypass":0,"temp":94,"temps":null,"um":600,"c40":22,"c40txt":"20–24 格","gl":"20–24 格","pours":[{"t":0,"add":75,"to":75},{"t":30,"add":75,"to":150},{"t":60,"add":150,"to":300}],"done":"2:00–2:45","beans":"水洗淺焙、柑橘花香系（衣索比亞水洗、肯亞）。大水量、注水少，萃取偏輕，讓酸質和香氣站在前面。","bean":"耶加雪菲","est":"","ey":20.2,"tds":1.38},{"id":"orea-ice","cat":"orea","name":"The Ice","by":"","desc":"冰咖啡（急速冷卻）配方：四段溫柔螺旋注水，明亮不水，適合水洗豆。","gear":"OREA＋蛋糕濾紙","drip":"orea","sw":false,"dose":18,"water":160,"ice":140,"bypass":0,"temp":94,"temps":null,"um":627,"c40":23,"c40txt":"22–24 格","gl":"22–24 格","pours":[{"t":0,"add":40,"to":40},{"t":40,"add":40,"to":80},{"t":60,"add":40,"to":120},{"t":80,"add":40,"to":160}],"done":"1:40–2:20","beans":"官方指定水洗豆。冰會壓低甜感和香氣，酸質明亮的水洗淺焙（衣索比亞、肯亞）冰了最不會變水。","bean":"耶加雪菲","est":"","ey":18.6,"tds":1.27},{"id":"orea-techno","cat":"orea","name":"The Techno","by":"Mordy","desc":"越注越快的節奏：後兩注改成中心注水。","gear":"OREA＋平底濾紙＋Negotiator","drip":"orea_neg","sw":false,"dose":12.4,"water":200,"ice":0,"bypass":0,"temp":94,"temps":null,"um":668,"c40":24.5,"c40txt":"23–26 格","gl":"23–26 格","pours":[{"t":0,"add":40,"to":40},{"t":30,"add":80,"to":120},{"t":80,"add":40,"to":160,"half":1},{"t":105,"add":40,"to":200,"center":1}],"done":"2:30–3:00","beans":"粉量少（12.4 g）、研磨偏粗，適合高價的淺焙藝伎、競標豆：用少少的粉沖出層次。","bean":"藝伎","est":"","ey":19.4,"tds":1.38},{"id":"orea-bypass","cat":"orea","name":"The Bypass","by":"英國沖煮冠軍 Matteo D’Ottavio","desc":"萃取 260 g 後，再加 15–30 g 熱水稀釋（bypass）平衡杯子。","gear":"OREA＋蛋糕濾紙","drip":"orea","sw":false,"dose":18,"water":260,"ice":0,"bypass":30,"temp":96,"temps":null,"um":600,"c40":22,"c40txt":"20–24 格","gl":"20–24 格","pours":[{"t":0,"add":60,"to":60},{"t":40,"add":100,"to":160},{"t":90,"add":100,"to":260}],"done":"2:30–3:00","beans":"風味很濃、很容易沖得太